{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "oidcSubject": {
      "type": "string",
      "metadata": {
        "description": "GitHub Actions が表示した OIDC subject。手入力版の azure-standby-deploy ブランチ専用です。"
      },
      "defaultValue": "repo:Yukihira-kc/subtitle-server:ref:refs/heads/azure-standby-deploy",
      "allowedValues": [
        "repo:Yukihira-kc/subtitle-server:ref:refs/heads/azure-standby-deploy",
        "repo:Yukihira-kc@287911253/subtitle-server@1249932154:ref:refs/heads/azure-standby-deploy"
      ]
    }
  },
  "variables": {
    "appName": "subtitle-standby-jp",
    "appId": "[resourceId('Microsoft.Web/sites', variables('appName'))]",
    "authorizeDeployment": "authorize-subtitle-standby-github"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[variables('authorizeDeployment')]",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "appName": {
            "value": "[last(split(reference(variables('appId'), '2024-11-01', 'Full').id, '/'))]"
          },
          "oidcSubject": {
            "value": "[parameters('oidcSubject')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "appName": {
              "type": "string",
              "allowedValues": ["subtitle-standby-jp"]
            },
            "oidcSubject": {
              "type": "string"
            }
          },
          "variables": {
            "appId": "[resourceId('Microsoft.Web/sites', parameters('appName'))]",
            "identityName": "id-subtitle-standby-github-deploy",
            "identityId": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]",
            "role": "[guid(variables('appId'), 'subtitle-standby-github-publish')]",
            "roleId": "[resourceId('Microsoft.Authorization/roleDefinitions', variables('role'))]"
          },
          "resources": [
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "[variables('identityName')]",
              "location": "[resourceGroup().location]"
            },
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
              "apiVersion": "2023-01-31",
              "name": "[concat(variables('identityName'), '/github-standby-deploy')]",
              "dependsOn": ["[variables('identityId')]"],
              "properties": {
                "issuer": "https://token.actions.githubusercontent.com",
                "subject": "[parameters('oidcSubject')]",
                "audiences": ["api://AzureADTokenExchange"]
              }
            },
            {
              "type": "Microsoft.Authorization/roleDefinitions",
              "apiVersion": "2022-04-01",
              "name": "[variables('role')]",
              "properties": {
                "roleName": "[concat('Subtitle standby App Service publish ', uniqueString(variables('appId')))]",
                "description": "Access the Kudu service to read and publish the manual caption standby app.",
                "type": "customRole",
                "permissions": [
                  {
                    "actions": ["Microsoft.Web/sites/publish/action"],
                    "notActions": [],
                    "dataActions": [],
                    "notDataActions": []
                  }
                ],
                "assignableScopes": ["[resourceGroup().id]"]
              }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(variables('appId'), variables('identityId'), variables('role'))]",
              "scope": "[format('Microsoft.Web/sites/{0}', parameters('appName'))]",
              "dependsOn": ["[variables('identityId')]", "[variables('roleId')]"],
              "properties": {
                "principalId": "[reference(variables('identityId'), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal",
                "roleDefinitionId": "[reference(variables('roleId'), '2022-04-01', 'Full').id]"
              }
            }
          ],
          "outputs": {
            "githubConfig": {
              "type": "object",
              "value": {
                "tenantId": "[subscription().tenantId]",
                "clientId": "[reference(variables('identityId'), '2023-01-31').clientId]",
                "resourceId": "[variables('appId')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "githubConfig": {
      "type": "string",
      "value": "[string(reference(resourceId('Microsoft.Resources/deployments', variables('authorizeDeployment')), '2022-09-01').outputs.githubConfig.value)]"
    }
  }
}
